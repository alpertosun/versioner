{
  "rules": [
    {
      "pattern": "^main$",
      "strategy": "master",
      "prefix": "",
      "suffix": ""
    },
    {
      "pattern": "^master$",
      "strategy": "master",
      "prefix": "",
      "suffix": ""
    },
    {
      "pattern": "^release\\/(\\d+)\\.(\\d+)\\.0$",
      "strategy": "release",
      "prefix": "",
      "suffix": ""
    },
    {
      "pattern": "^develop$",
      "strategy": "develop",
      "prefix": "",
      "suffix": ""
    },
    {
      "pattern": "^feature\\/.*$",
      "strategy": "feature",
      "prefix": "",
      "suffix": ""
    },
    {
      "pattern": "^hotfix\\/.*$",
      "strategy": "hotfix",
      "prefix": "",
      "suffix": ""
    }
  ]
}
